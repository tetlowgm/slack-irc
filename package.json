{
  "name": "slack-irc",
  "version": "3.11.3",
  "description": "Connects IRC and Slack channels by sending messages back and forth.",
  "keywords": [
    "slack",
    "irc",
    "gateway",
    "bot",
    "slack-irc"
  ],
  "type": "module",
  "main": "lib/index.js",
  "bin": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:ekmartin/slack-irc.git"
  },
  "engines": {
    "node": ">=20.10"
  },
  "bugs": {
    "url": "https://github.com/ekmartin/slack-irc/issues"
  },
  "scripts": {
    "start": "node lib/index.js",
    "test": "npm run lint && npm run coverage",
    "lint": "eslint .",
    "mocha": "mocha",
    "coverage": "c8 mocha"
  },
  "mocha": {
    "spec": "test/**/*.test.js",
    "recursive": true,
    "timeout": 5000
  },
  "author": {
    "name": "Martin Ek <mail@ekmartin.no>"
  },
  "license": "MIT",
  "dependencies": {
    "@slack/bolt": "^4.7.3",
    "check-env": "1.3.0",
    "commander": "2.20.0",
    "irc-upd": "0.10.0",
    "lodash": "^4.18.1",
    "strip-json-comments": "3.0.1",
    "winston": "3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "c8": "^10.1.3",
    "chai": "^5.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^15.15.0",
    "mocha": "^11.7.6",
    "sinon": "^19.0.5",
    "sinon-chai": "^4.0.1"
  }
}
